{
	"name": "@codeindex/adapter-oracle",
	"version": "0.1.0",
	"private": false,
	"description": "adapter-oracle adapter for CodeIndex.",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./internals": {
			"types": "./src/internals.ts",
			"default": "./src/internals.ts"
		},
		"./package.json": "./package.json",
		"./*": "./src/*.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./internals": {
				"types": "./dist/internals.d.ts",
				"default": "./dist/internals.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@codeindex/adapter-sdk": "workspace:*",
		"antlr4ng": "3.0.16"
	}
}
