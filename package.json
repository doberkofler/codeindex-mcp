{
	"name": "codeindex-mcp",
	"version": "0.16.1",
	"private": false,
	"description": "Local, language-neutral code index exposed to MCP clients.",
	"homepage": "https://github.com/doberkofler/codeindex-mcp",
	"bugs": {
		"url": "https://github.com/doberkofler/codeindex-mcp/issues"
	},
	"license": "MIT",
	"author": "Dieter Oberkofler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/doberkofler/codeindex-mcp.git"
	},
	"bin": {
		"codeindex-cli": "dist/cli.mjs",
		"codeindex-console": "dist/console.mjs",
		"codeindex-mcp": "dist/mcp.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"type": "module",
	"exports": {
		"./mcp": "./dist/mcp.mjs",
		"./cli": "./dist/cli.mjs",
		"./console": "./dist/console.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepare": "node scripts/build.mjs && husky",
		"release": "release-it",
		"build": "node scripts/build.mjs",
		"benchmark:typescript:public:prepare": "pnpm run build && node dist/cli.mjs benchmark-prepare --suite benchmark/suites/typescript-public.json",
		"benchmark:multi-adapter": "pnpm run build && node dist/cli.mjs benchmark-multi-adapter --baseline benchmark/baseline-multi-adapter.json",
		"benchmark:typescript:public": "pnpm run build && node dist/cli.mjs benchmark-suite --suite benchmark/suites/typescript-public.json",
		"benchmark:typescript:generated": "pnpm run build && node dist/cli.mjs benchmark-suite --suite benchmark/suites/typescript-generated.json",
		"benchmark:oracle:corpus": "pnpm run build && node dist/cli.mjs benchmark --extractor oracle",
		"benchmark:oracle:production": "pnpm run build && node --experimental-strip-types scripts/benchmarkOracleProduction.ts",
		"eval:check": "node evaluation/harness/src/cli.ts check --suite suites/q2.json",
		"eval:list": "node evaluation/harness/src/cli.ts list --suite suites/q2.json",
		"eval:evaluate": "node evaluation/harness/src/cli.ts evaluate --suite suites/q2.json",
		"eval:report": "node evaluation/harness/src/cli.ts report",
		"eval:test": "vitest run evaluation/harness --coverage.enabled=false",
		"eval:typecheck": "tsc -p evaluation/harness/tsconfig.json",
		"eval:verify": "pnpm run eval:typecheck && pnpm run eval:test",
		"qualify:typescript": "node --experimental-strip-types src/entries/qualify.ts qualify --extractor typescript",
		"qualify:typescript:fixture": "pnpm run qualify:typescript:fixture:built",
		"qualify:typescript:fixture:built": "node --experimental-strip-types src/entries/qualify.ts qualify --extractor typescript --root test/fixtures/reference-corpus --project-file test/fixtures/reference-corpus/tsconfig.json",
		"qualify:oracle": "node --experimental-strip-types src/entries/qualify.ts qualify --extractor oracle",
		"qualify:oracle:live": "node --experimental-strip-types src/entries/qualify.ts qualify-oracle-live",
		"test:fast": "node scripts/run-test-workflow.mjs fast",
		"test:typescript": "node scripts/run-test-workflow.mjs typescript",
		"test:mcp": "node scripts/run-test-workflow.mjs mcp",
		"test:system": "node scripts/run-test-workflow.mjs system",
		"test:oracle": "node scripts/run-test-workflow.mjs oracle",
		"test:oracle:bundle": "node scripts/run-test-workflow.mjs oracle:bundle",
		"test:oracle:live": "node scripts/run-test-workflow.mjs oracle:live",
		"commitlint": "commitlint",
		"grammar:oracle:download": "node --experimental-strip-types scripts/downloadOracleGrammar.ts",
		"grammar:oracle:generate": "node --experimental-strip-types scripts/generateOracleGrammar.ts",
		"console": "node dist/console.mjs",
		"status": "node dist/cli.mjs status",
		"queue": "agent-task-queue",
		"update": "node dist/cli.mjs update",
		"rebuild": "node dist/cli.mjs rebuild",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.console.json && tsc -p evaluation/harness/tsconfig.json",
		"lint": "oxlint",
		"knip": "knip",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"index:verify": "node dist/cli.mjs verify",
		"verify:references": "node --experimental-strip-types scripts/verifyReferences.ts",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run format:check && pnpm run test",
		"verify:pr": "node scripts/run-test-workflow.mjs verify:pr",
		"verify:release": "pnpm run verify && pnpm run build && node scripts/check-release-version.mjs",
		"build:packages": "pnpm --filter @codeindex/adapter-sdk run build && pnpm --filter @codeindex/adapter-typescript run build && pnpm --filter @codeindex/adapter-oracle run build",
		"test:packages": "node scripts/packageSmoke.mjs"
	},
	"dependencies": {
		"@codeindex/adapter-sdk": "workspace:*",
		"@modelcontextprotocol/server": "2.4.0",
		"chokidar": "6.0.0",
		"commander": "15.0.0",
		"debug": "4.4.3",
		"jsonc-parser": "3.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@codeindex/adapter-oracle": "workspace:*",
		"@codeindex/adapter-oracle-tools": "workspace:*",
		"@codeindex/adapter-typescript": "workspace:*",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@modelcontextprotocol/client": "2.4.0",
		"@mui/icons-material": "9.5.0",
		"@mui/material": "9.5.0",
		"@release-it/conventional-changelog": "12.0.2",
		"@tanstack/react-query": "5.106.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/debug": "4.1.13",
		"@types/node": "26.6.6",
		"@types/oracledb": "26.0.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "5.1.0",
		"agent-task-queue": "0.7.0",
		"antlr-ng": "1.0.10",
		"antlr4ng": "3.0.16",
		"eslint-plugin-regexp": "3.3.3",
		"husky": "9.1.7",
		"jsdom": "^31.0.0",
		"knip": "6.44.1",
		"oracledb": "26.0.0",
		"oxfmt": "0.77.0",
		"oxlint": "1.92.0",
		"oxlint-tsgolint": "7.0.2006",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"release-it": "21.1.2",
		"typescript": "6.0.3",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=26"
	}
}
