{
	"schemaVersion": 1,
	"id": "codeindex-release-model-free",
	"suite": {
		"id": "codeindex-release",
		"version": 1
	},
	"routes": [
		{
			"caseId": "locate-schema-version",
			"text": [
				{
					"kind": "search",
					"id": "search-declaration",
					"pattern": "\\bconst\\s+SCHEMA_VERSION\\b",
					"path": "src",
					"collect": true
				}
			],
			"codeindex": [
				{
					"kind": "mcp",
					"id": "find-declaration",
					"tool": "find_symbol",
					"arguments": {
						"query": "SCHEMA_VERSION",
						"match": "name",
						"exposure": "any"
					},
					"collect": "exact-name-paths",
					"exactName": "SCHEMA_VERSION"
				}
			]
		},
		{
			"caseId": "locate-read-symbol-tool",
			"text": [
				{
					"kind": "search",
					"id": "search-registration",
					"pattern": "name:\\s*'read_symbol'",
					"path": "src",
					"collect": true
				}
			],
			"codeindex": [
				{
					"kind": "mcp",
					"id": "find-tool-name",
					"tool": "find_symbol",
					"arguments": {
						"query": "read_symbol",
						"match": "name",
						"exposure": "any"
					},
					"collect": "none"
				},
				{
					"kind": "search",
					"id": "fallback-registration",
					"pattern": "name:\\s*'read_symbol'",
					"path": "src",
					"collect": true
				}
			]
		},
